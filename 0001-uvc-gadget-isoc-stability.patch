+/*
+ * Decide how the video stream is split into USB requests.
+ *
+ * With pacing enabled the goal is one request per isochronous service interval,
+ * so that the payload handed to the endpoint matches the rate at which the host
+ * drains it. Filling the endpoint with a whole frame at once makes the UDC
+ * queue many requests into consecutive service intervals which the host cannot
+ * consume in time; the leftover TRBs are then reported as missed isochronous
+ * transfers and the corresponding frame is dropped.
+ */
+static void
+uvc_video_prep_requests(struct uvc_video *video)
+{
+	struct uvc_device *uvc = container_of(video, struct uvc_device, video);
+	struct usb_composite_dev *cdev = uvc->func.config->cdev;
+	unsigned int max_req_size, req_size, interval, header_size;
+	unsigned int interval_duration;
+	unsigned int nreq;
+
+	max_req_size = video->ep->maxpacket
+		 * max_t(unsigned int, video->ep->maxburst, 1)
+		 * (video->ep->mult);
+	video->max_req_size = max_req_size;
+
+	if (!usb_endpoint_xfer_isoc(video->ep->desc)) {
+		/* Bulk: one request per maximum sized chunk. */
+		video->req_size = max_req_size;
+		video->uvc_num_requests =
+			DIV_ROUND_UP(video->imagesize, max_req_size);
+		video->reqs_per_frame = 0;
+		return;
+	}
+
+	if (!pacing) {
+		/*
+		 * Legacy behaviour: one request per service interval at the
+		 * maximum endpoint bandwidth. video->uvc_num_requests keeps the
+		 * value computed by uvc_queue_setup().
+		 */
+		video->req_size = max_req_size;
+		video->reqs_per_frame = 0;
+		return;
+	}
+
+	interval = video->interval ? video->interval : interval_100ns;
+	if (!interval)
+		interval = 333333;	/* 30 fps fallback, in 100ns units */
+
+	interval_duration = 1 << (video->ep->desc->bInterval - 1);
+	if (cdev->gadget->speed < USB_SPEED_HIGH)
+		interval_duration *= 10000;
+	else
+		interval_duration *= 1250;
+
+	nreq = DIV_ROUND_UP(interval, interval_duration);
+	nreq = max(min(nreq, max_reqs_per_frame), 1U);
+
+	header_size = nreq * UVCG_REQUEST_HEADER_LEN;
+	req_size = DIV_ROUND_UP(video->imagesize + header_size, nreq);
+	if (req_size > max_req_size)
+		req_size = max_req_size;
+	if (req_size < (UVCG_REQUEST_HEADER_LEN + 1))
+		req_size = UVCG_REQUEST_HEADER_LEN + 1;
+
+	video->req_size = req_size;
+	video->reqs_per_frame = nreq;
+	video->uvc_num_requests = nreq + spare_reqs;
+
+}
